---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import AboutTabs from '../components/AboutTabs.astro';
import BandRoster from '../components/BandRoster.astro';
import { BANDS } from '../data/members';
---

<Base titleKey="members.title">
  <main class="page">
    <h1><T k="members.title" /></h1>
    <AboutTabs />
    <p class="muted"><T k="members.intro" /></p>
    <BandRoster bands={BANDS} emptyKey="members.empty" />
  </main>
</Base>
