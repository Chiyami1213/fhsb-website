---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import AboutTabs from '../components/AboutTabs.astro';
// Timeline 2011 -> 2026 (oldest first). Each year shows a placeholder: replace it with that year's real milestone.
const FIRST_YEAR = 2011;
const LAST_YEAR = 2026;
const years = Array.from({ length: LAST_YEAR - FIRST_YEAR + 1 }, (_, i) => FIRST_YEAR + i);
---

<Base titleKey="history.title">
  <main class="page">
    <h1><T k="history.title" /></h1>
    <AboutTabs />
    <p class="muted"><T k="history.intro" /></p>
    <ul class="timeline">
      {
        years.map((y) => (
          <li>
            <div class="year">{y}</div>
            <div><T k="history.item" /></div>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
