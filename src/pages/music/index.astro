---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import MusicTabs from '../../components/MusicTabs.astro';
import EntryList from '../../components/EntryList.astro';
import { getEntries, hasTag } from '../../lib/entries';
const entries = await getEntries((e) => hasTag(e, 'repertoire', 'recording'));
---

<Base titleKey="music.title">
  <main class="page">
    <h1><T k="music.title" /></h1>
    <p class="muted"><T k="music.intro" /></p>
    <MusicTabs />
    <EntryList entries={entries} emptyKey="music.empty" />
  </main>
</Base>
