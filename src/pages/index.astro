---
import Base from '../layouts/Base.astro';
import NameLine from '../components/NameLine.astro';
import { SITE } from '../config';
---

<Base>
  <main class="home">
    <h1>
      <span class="zh">{SITE.titleZh}</span>
      <!-- the English name is drawn in the logo's lettering (purple F H S B, grey rest); the text stays for screen readers -->
      <span class="en">
        <span class="sr-only">{SITE.titleEn}</span>
        <NameLine />
      </span>
    </h1>
  </main>
</Base>
