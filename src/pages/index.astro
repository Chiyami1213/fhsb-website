---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

// F, H, S, B inside "Fuhsing Symphonic Band" are shown in the brand purple, the other letters in grey.
const HIGHLIGHT = [0, 2, 8, 18];
const chars = [...SITE.titleEn];
if (HIGHLIGHT.some((at, k) => chars[at]?.toUpperCase() !== 'FHSB'[k])) {
  throw new Error('SITE.titleEn no longer matches the F-H-S-B highlight positions in src/pages/index.astro');
}
---

<Base>
  <main class="home">
    <h1>
      <span class="zh">{SITE.titleZh}</span>
      <span class="en">{chars.map((ch, i) => (HIGHLIGHT.includes(i) ? <span class="hl">{ch}</span> : ch))}</span>
    </h1>
  </main>
</Base>
