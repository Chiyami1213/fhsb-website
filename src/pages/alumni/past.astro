---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import AlumniTabs from '../../components/AlumniTabs.astro';
import { ALUMNI } from '../../data/alumni';
import { INSTRUMENTS } from '../../data/members';

// One section per instrument; inside it the alumni who played it, oldest cohort (屆) first.
// An alumnus with several instruments appears in each of those sections. People without a cohort come last.
const byInstrument = INSTRUMENTS.map((id) => ({
  id,
  people: ALUMNI.filter((a) => a.instruments.includes(id)).sort(
    (a, b) => (a.cohort ?? 9999) - (b.cohort ?? 9999) || a.name.localeCompare(b.name, 'zh-Hant'),
  ),
}));
// Before any alumni are entered every instrument shows (empty); afterwards only instruments that have alumni.
const shown = ALUMNI.length === 0 ? byInstrument : byInstrument.filter((s) => s.people.length > 0);
---

<Base titleKey="alumni.past.title">
  <main class="page">
    <h1><T k="alumni.past.title" /></h1>
    <AlumniTabs />
    <p class="muted"><T k="alumni.past.intro" /></p>
    {ALUMNI.length === 0 && <p class="muted"><T k="alumni.past.empty" /></p>}

    <!-- jump links to each instrument -->
    <div class="chips" style="margin-top:.8rem">
      {shown.map((s) => <a class="chip" href={`#${s.id}`}><T k={`inst.${s.id}`} /></a>)}
    </div>

    {
      shown.map((s) => (
        <section class="band" id={s.id}>
          <h2 class="inst-h">
            <span class="inst-ico" aria-hidden="true" style={`--m:url(/images/instruments/${s.id}.png)`} />
            <T k={`inst.${s.id}`} />
          </h2>
          {s.people.length > 0 ? (
            <ul class="alumni-list">
              {s.people.map((a) => (
                <li>
                  <span class="cohort">{a.cohort ? `第${a.cohort}屆` : '—'}</span>
                  <span>{a.name}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">—</p>
          )}
        </section>
      ))
    }
  </main>
</Base>
