---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import EntryList from '../../components/EntryList.astro';
import { getEntries, hasTag } from '../../lib/entries';

export async function getStaticPaths() {
  const entries = await getEntries();
  const tags = [...new Set(entries.flatMap((e) => e.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { entries: entries.filter((e) => hasTag(e, tag)) },
  }));
}
const { tag } = Astro.params;
const { entries } = Astro.props;
---

<Base titleKey="tags.title">
  <main class="page">
    <h1><T k="tags.title" />: #{tag}</h1>
    <EntryList entries={entries} emptyKey="tags.empty" />
  </main>
</Base>
