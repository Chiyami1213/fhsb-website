---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import EntryList from '../components/EntryList.astro';
import { getEntries, hasTag } from '../lib/entries';
const entries = await getEntries((e) => hasTag(e, 'concert'));
---

<Base titleKey="concerts.title">
  <main class="page">
    <h1><T k="concerts.title" /></h1>
    <p class="muted"><T k="concerts.intro" /></p>
    <EntryList entries={entries} emptyKey="concerts.empty" />
  </main>
</Base>
