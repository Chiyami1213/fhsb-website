---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import EntryList from '../components/EntryList.astro';
import { getEntries, hasTag } from '../lib/entries';
import { PERFORMANCES } from '../data/concerts';

// 演出典藏: same timeline as 沿革 (one entry per year, oldest first), listing the performances of src/data/concerts.ts.
// Only years that have performances are shown. Detailed entries tagged `concert` follow below.
const sorted = [...PERFORMANCES].sort((a, b) => a.date.localeCompare(b.date));
const years = [...new Set(sorted.map((p) => p.date.slice(0, 4)))];
const md = (iso: string) => iso.slice(5).replace('-', '/'); // "2016-07-06" -> "07/06"
const when = (p: { date: string; end?: string }) => (p.end ? `${md(p.date)}–${md(p.end)}` : md(p.date));

const entries = await getEntries((e) => hasTag(e, 'concert'));
---

<Base titleKey="concerts.title">
  <main class="page">
    <h1><T k="concerts.title" /></h1>
    <p class="muted"><T k="concerts.intro" /></p>

    {sorted.length === 0 && <p class="empty"><T k="concerts.empty" /></p>}

    <ul class="timeline">
      {
        years.map((y) => (
          <li>
            <div class="year">{y}</div>
            {sorted
              .filter((p) => p.date.startsWith(y))
              .map((p) => (
                <div class="event">
                  <span class="when">{when(p)}</span> {p.name}
                </div>
              ))}
          </li>
        ))
      }
    </ul>

    {entries.length > 0 && <EntryList entries={entries} emptyKey="concerts.empty" />}
  </main>
</Base>
