---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import LoaderLogo from '../components/LoaderLogo.astro';
import { DICT, en } from '../i18n/dict';
import { SITE, NAV_TOP, NAV_BOTTOM, EASTER_EGG_URL, ALLOW_SEARCH_INDEXING } from '../config';

interface Props {
  /** dictionary key for the page title (translated) */
  titleKey?: string;
  /** literal title (not translated), e.g. an entry title */
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { titleKey, title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
// an item is "in section" on its own page and on its sub-tabs' pages (keeps the sub-tabs open)
const inSection = (item: { href: string; children?: { href: string }[] }) =>
  isCurrent(item.href) || !!item.children?.some((c) => path.startsWith(c.href));
// drill-down: on a sub-tab page (e.g. History) the menu shows only that section: the parent (About) on top with its
// sub-tabs under it, and an arrow at the top that goes back to the main menu. Global items (Settings) stay put.
const section = NAV_TOP.find((it) => it.children?.some((c) => path.startsWith(c.href)));
const pageTitle = titleKey ? `${en(titleKey)} · ${SITE.short}` : title ? `${title} · ${SITE.short}` : `${SITE.titleZh} ${SITE.titleEn}`;
const metaDesc = description ?? `${SITE.titleZh} ${SITE.titleEn} (${SITE.short})`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDesc} />
    {(noindex || !ALLOW_SEARCH_INDEXING) && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-256.png" sizes="256x256" />
    {
      titleKey ? (
        <title data-i18n={titleKey} data-i18n-suffix={` · ${SITE.short}`}>{pageTitle}</title>
      ) : (
        <title>{pageTitle}</title>
      )
    }

    <!-- 1. theme: applied before first paint -->
    <script is:inline>
      (function () {
        try {
          var v = localStorage.getItem('fhsb-theme');
          if (v === 'light' || v === 'dark') document.documentElement.setAttribute('data-theme', v);
        } catch (e) {}
      })();
    </script>

    <!-- 2. language: window.t / window.setLang.
         Default = Traditional Chinese for visitors in Mandarin-speaking regions, English elsewhere
         (decided by /api/lang). A language picked in the switcher always wins and is remembered. -->
    <script is:inline define:vars={{ DICT }}>
      (function () {
        var LANGS = { en: 'en', zh: 'zh-TW' };
        var CODES = { en: 'EN', zh: 'CN' };
        var KEY = 'fhsb-lang'; // explicit choice (localStorage)
        var AUTO = 'fhsb-autolang'; // detected for this browser session (sessionStorage)
        var has = function (o, k) {
          return Object.prototype.hasOwnProperty.call(o, k);
        };
        var root = document.documentElement;
        var cur = 'zh'; // tentative until the region check answers
        var explicit = false;
        var resolved = false;
        var domReady = false;
        try {
          var s = localStorage.getItem(KEY);
          if (s && has(LANGS, s)) {
            cur = s;
            explicit = true;
            resolved = true;
          }
        } catch (e) {}
        if (!resolved) {
          try {
            var a = sessionStorage.getItem(AUTO);
            if (a && has(LANGS, a)) {
              cur = a;
              resolved = true;
            }
          } catch (e) {}
        }
        root.lang = LANGS[cur];
        // hide the page for a moment so the wrong language never flashes (with a failsafe)
        if (cur !== 'en') {
          root.classList.add('i18n-pending');
          setTimeout(function () {
            root.classList.remove('i18n-pending');
          }, 1500);
        }
        function t(key, vars) {
          var e = DICT[key];
          var s = e ? e[cur] || e.en : key;
          if (vars) {
            s = s.replace(/\{(\w+)\}/g, function (m, k) {
              return has(vars, k) ? vars[k] : m;
            });
          }
          return s;
        }
        function all(attr) {
          return document.querySelectorAll('[' + attr + ']');
        }
        function apply() {
          all('data-i18n').forEach(function (el) {
            el.textContent = t(el.getAttribute('data-i18n')) + (el.getAttribute('data-i18n-suffix') || '');
          });
          all('data-i18n-html').forEach(function (el) {
            el.innerHTML = t(el.getAttribute('data-i18n-html'));
          });
          all('data-i18n-placeholder').forEach(function (el) {
            el.setAttribute('placeholder', t(el.getAttribute('data-i18n-placeholder')));
          });
          all('data-i18n-title').forEach(function (el) {
            el.setAttribute('title', t(el.getAttribute('data-i18n-title')));
          });
          all('data-i18n-label').forEach(function (el) {
            el.setAttribute('aria-label', t(el.getAttribute('data-i18n-label')));
          });
          var code = document.getElementById('langcode');
          if (code) code.textContent = CODES[cur];
          all('data-lang').forEach(function (el) {
            el.setAttribute('aria-checked', el.getAttribute('data-lang') === cur ? 'true' : 'false');
          });
          root.lang = LANGS[cur];
          root.classList.remove('i18n-pending');
        }
        function setLang(l) {
          if (!has(LANGS, l)) return;
          cur = l;
          explicit = true;
          resolved = true;
          try {
            localStorage.setItem(KEY, l);
          } catch (e) {}
          apply();
          document.dispatchEvent(new CustomEvent('langchange', { detail: { lang: l } }));
        }
        // result of the region check (ignored if the visitor already chose a language)
        function finish(l) {
          if (explicit || resolved) return;
          resolved = true;
          var changed = l !== cur;
          cur = l;
          try {
            sessionStorage.setItem(AUTO, l);
          } catch (e) {}
          if (domReady) {
            apply();
            if (changed) document.dispatchEvent(new CustomEvent('langchange', { detail: { lang: l } }));
          }
        }
        function guess() {
          return /^zh/i.test(navigator.language || '') ? 'zh' : 'en';
        }
        if (!resolved) {
          var timer = setTimeout(function () {
            finish(guess());
          }, 1200);
          try {
            fetch('/api/lang', { cache: 'no-store' })
              .then(function (r) {
                if (!r.ok) throw new Error('lang');
                return r.json();
              })
              .then(function (d) {
                clearTimeout(timer);
                finish(d && d.lang === 'zh' ? 'zh' : 'en');
              })
              .catch(function () {
                clearTimeout(timer);
                finish(guess());
              });
          } catch (e) {
            clearTimeout(timer);
            finish(guess());
          }
        }
        window.t = t;
        window.setLang = setLang;
        window.getLang = function () {
          return cur;
        };
        function onReady() {
          domReady = true;
          if (resolved) apply();
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', onReady);
        else onReady();
      })();
    </script>

    <!-- 3. loading screen: first visit of a session + every reload, never on /admin.
         Timeline (ms): logo builds (0-2300) -> window opens (2600) -> instruments leave right, full name leaves
         left (3400) -> big FHSB turns purple (4100) -> it shrinks onto the home subtitle (4400) -> the push-out
         replays there: purple F H S B spread, grey text opens (5000) -> settles into the real title (6000) -> done (6600). -->
    <script is:inline>
      (function () {
        try {
          if (/^\/admin(\/|$)/.test(location.pathname)) return;
          var nav = performance.getEntriesByType('navigation')[0];
          var reload = !!nav && nav.type === 'reload';
          if (!reload && sessionStorage.getItem('fhsb-seen')) return;
          sessionStorage.setItem('fhsb-seen', '1');
          var d = document.documentElement;
          var calm = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
          var big = []; // the four big FHSB letters
          var hand = null; // the handover layer: row 3's push-out replayed at the subtitle's size and place
          d.classList.add('loading');
          function done() {
            d.classList.remove('loading', 'open', 'leave', 'purple', 'shrink', 'spread', 'settle');
            var l = document.getElementById('loader');
            if (l) l.remove();
            if (hand) hand.remove();
          }
          // measure the home subtitle and fly the (purple) big letters onto the bunched small capitals
          function shrink() {
            try {
              big = [].slice.call(document.querySelectorAll('.logo-anim .fhsb-l'));
              var en = document.querySelector('.home h1 .en');
              var row = document.querySelector('.logo-anim:not(.handover) .lp-name');
              if (!big.length) return;
              if (!en || !row) {
                // no title to land on (other pages): the big letters just fade away
                big.forEach(function (el) {
                  el.style.animation = 'none';
                  el.style.transition = 'opacity 0.5s ease';
                  el.style.opacity = '0';
                });
                return;
              }
              var range = document.createRange();
              range.selectNodeContents(en);
              var t = range.getBoundingClientRect();
              var h = (t.width * row.offsetHeight) / row.offsetWidth;
              hand = document.createElement('div');
              hand.className = 'logo-anim handover';
              hand.style.cssText =
                'left:' + t.left + 'px;top:' + (t.top + t.height / 2 - h / 2) + 'px;width:' + t.width + 'px;height:' + h + 'px';
              var clone = row.cloneNode(true);
              clone.removeAttribute('style');
              hand.appendChild(clone);
              document.body.appendChild(hand);
              // timing inside the replay: the purple capitals spread at once, the grey text opens a beat later
              var kids = clone.children;
              var n = 0;
              for (var i = 0; i < kids.length; i++) {
                if (kids[i].classList.contains('gather')) kids[i].style.setProperty('--hd', '0s');
                else kids[i].style.setProperty('--hd', 0.28 + 0.08 * n++ + 's');
              }
              var targets = [].slice.call(clone.querySelectorAll('.gather'));
              big.forEach(function (el, i) {
                var a = el.getBoundingClientRect();
                var b = targets[i].getBoundingClientRect();
                el.style.animation = 'none';
                el.style.transformOrigin = '50% 50%';
                void el.offsetWidth;
                el.style.transition = 'transform 0.55s cubic-bezier(0.65, 0, 0.25, 1)';
                el.style.transform =
                  'translate(' + (b.left + b.width / 2 - a.left - a.width / 2) + 'px,' + (b.top + b.height / 2 - a.top - a.height / 2) + 'px) ' +
                  'scale(' + b.width / a.width + ',' + b.height / a.height + ')';
              });
            } catch (e) {}
          }
          // the replay takes over from the big letters: purple capitals spread, grey text opens
          function spread() {
            if (!hand) return;
            hand.classList.add('show', 'go');
            big.forEach(function (el) {
              el.style.transition = 'opacity 0.25s ease';
              el.style.opacity = '0';
            });
          }
          setTimeout(function () {
            d.classList.add('open');
          }, 2600);
          if (calm) {
            setTimeout(done, 3600);
            return;
          }
          setTimeout(function () {
            d.classList.add('leave');
          }, 3400);
          setTimeout(function () {
            d.classList.add('purple');
          }, 4100);
          setTimeout(function () {
            d.classList.add('shrink');
            shrink();
          }, 4400);
          setTimeout(function () {
            d.classList.add('spread');
            spread();
          }, 5000);
          setTimeout(function () {
            d.classList.add('settle');
          }, 6000);
          setTimeout(done, 6600);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <button class="burger" id="burger" type="button" aria-controls="rail" aria-expanded="false" data-i18n-label="menu.open" aria-label={en('menu.open')}>
        <Icon name="menu" />
      </button>
      <div class="backdrop" id="backdrop"></div>

      <aside class="rail" id="rail" data-view={section ? 'section' : 'main'} data-i18n-label="menu.aria" aria-label={en('menu.aria')}>
        <nav>
          <div class="rail-toggle" aria-hidden="true"><Icon name="chevrons" /></div>
          {
            section && (
              <>
                <button class="rail-back" id="rail-back" type="button" data-i18n-label="menu.back" aria-label={en('menu.back')}>
                  <Icon name="chevrons" />
                  <span class="lbl" data-i18n="menu.back">{en('menu.back')}</span>
                </button>
                <ul class="nav section">
                  <li class="item">
                    <a href={section.href}>
                      <Icon name={section.icon} />
                      <span class="lbl" data-i18n={section.label}>{en(section.label)}</span>
                    </a>
                    <ul class="sub">
                      {section.children!.map((c) => (
                        <li>
                          <a href={c.href} aria-current={path.startsWith(c.href) ? 'page' : undefined}>
                            <span class="dot" />
                            <span data-i18n={c.label}>{en(c.label)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                </ul>
              </>
            )
          }
          {
            [NAV_TOP, NAV_BOTTOM].map((list, i) => (
              <ul class={i === 0 ? 'nav top' : 'nav bottom'}>
                {list.map((item) => (
                  <li class:list={['item', { current: inSection(item), 'has-sub': !!item.children, global: !!item.global }]}>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      <Icon name={item.icon} />
                      <span class="lbl" data-i18n={item.label}>{en(item.label)}</span>
                    </a>
                    {item.children && (
                      <ul class="sub">
                        {item.children.map((c) => (
                          <li>
                            <a href={c.href} aria-current={path.startsWith(c.href) ? 'page' : undefined}>
                              {c.logo ? (
                                <span class="logo" style={`--logo:url(${c.logo})`} />
                              ) : (
                                <span class="dot" />
                              )}
                              <span data-i18n={c.label}>{en(c.label)}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            ))
          }
        </nav>
      </aside>

      <div class="lang" id="lang">
        <button class="langbtn" id="langbtn" type="button" aria-haspopup="true" aria-expanded="false" data-i18n-label="lang.aria" aria-label={en('lang.aria')}>
          <Icon name="globe" />
          <span id="langcode">EN</span>
        </button>
        <ul class="langmenu" id="langmenu" role="menu" hidden>
          <li><button type="button" role="menuitemradio" data-lang="en" aria-checked="true">English</button></li>
          <li><button type="button" role="menuitemradio" data-lang="zh" aria-checked="false">中文（Mandarin）</button></li>
        </ul>
      </div>

      <div class="content">
        <slot />
      </div>

      <footer class="footer">{SITE.short} {SITE.year}</footer>
    </div>

    <div class="loader" id="loader" aria-hidden="true">
      <div class="panel l"></div>
      <div class="panel r"></div>
      <div class="center">
        {
          EASTER_EGG_URL ? (
            <a class="egg" href={EASTER_EGG_URL} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
              <LoaderLogo class="char" />
            </a>
          ) : (
            <LoaderLogo class="char" />
          )
        }
        <div class="ltext">
          <div class="now" lang="ja">そして次の曲が始まるのです<span class="dots"><i>.</i><i>.</i><i>.</i></span></div>
        </div>
      </div>
    </div>

    <script>
      const $ = (id: string) => document.getElementById(id)!;
      const rail = $('rail');
      const burger = $('burger');
      const backdrop = $('backdrop');
      function setRail(open: boolean) {
        rail.classList.toggle('open', open);
        backdrop.classList.toggle('show', open);
        burger.setAttribute('aria-expanded', String(open));
      }
      burger.addEventListener('click', () => setRail(!rail.classList.contains('open')));
      backdrop.addEventListener('click', () => setRail(false));
      // section view -> back to the main menu (stays on the page)
      document.getElementById('rail-back')?.addEventListener('click', () => {
        rail.dataset.view = 'main';
      });

      const langbtn = $('langbtn');
      const langmenu = $('langmenu');
      function setMenu(open: boolean) {
        langmenu.hidden = !open;
        langbtn.setAttribute('aria-expanded', String(open));
      }
      langbtn.addEventListener('click', (e) => {
        e.stopPropagation();
        setMenu(Boolean(langmenu.hidden));
      });
      langmenu.querySelectorAll<HTMLElement>('[data-lang]').forEach((b) =>
        b.addEventListener('click', () => {
          (window as any).setLang(b.dataset.lang);
          setMenu(false);
        }),
      );
      document.addEventListener('click', (e) => {
        if (!langmenu.hidden && !langmenu.contains(e.target as Node)) setMenu(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          setRail(false);
          setMenu(false);
        }
      });
    </script>
  </body>
</html>
