---
import T from './T.astro';
const path = Astro.url.pathname;
const tabs = [
  { href: '/alumni/', label: 'about.tab' },
  { href: '/alumni/past/', label: 'nav.alumni.past' },
];
---

<!-- in-page tab row (works when the menu is collapsed / on phones) -->
<div class="subtabs">
  {
    tabs.map((t) => (
      <a href={t.href} aria-current={path === t.href ? 'page' : undefined}>
        <T k={t.label} />
      </a>
    ))
  }
</div>
