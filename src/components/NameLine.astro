---
// "FuHsing Symphonic Band" in the logo's own lettering: purple capitals F H S B, the rest in grey.
// Built from the same pieces as the loading animation, so the animation lands on it without any change of style.
// Positions come from src/data/loader-layout.json (made by design/tools/make_loader_assets.py).
import layout from '../data/loader-layout.json';

const purple = layout.name.purple;
const ink = layout.name.ink;
const all = [...purple, ...ink];
const x0 = Math.min(...all.map((p) => p.x));
const y0 = Math.min(...all.map((p) => p.y));
const w = Math.max(...all.map((p) => p.x + p.w)) - x0;
const h = Math.max(...all.map((p) => p.y + p.h)) - y0;
type Box = { x: number; y: number; w: number; h: number };
const pct = (v: number, of: number) => ((v / of) * 100).toFixed(3);
const rel = (p: Box) => `left:${pct(p.x - x0, w)}%;top:${pct(p.y - y0, h)}%;width:${pct(p.w, w)}%;height:${pct(p.h, h)}%`;
---

<span class="name-line" aria-hidden="true" style={`aspect-ratio:${w}/${h}`}>
  {purple.map((p) => <img class="nl" src={p.src} alt="" decoding="async" style={rel(p)} />)}
  {ink.map((p) => <span class="nl nl-ink" style={`${rel(p)};--m:url(${p.src})`} />)}
</span>
